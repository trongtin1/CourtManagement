{
  "name": "court-management-be",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm --prefix CourtManagementBE.Api/ClientApp run dev",
    "dev:client": "npm --prefix CourtManagementBE.Api/ClientApp run dev",
    "dev:api": "dotnet watch run",
    "start": "dotnet run",
    "build": "dotnet build && npm --prefix CourtManagementBE.Api/ClientApp run build",
    "build:api": "dotnet build",
    "build:client": "npm --prefix CourtManagementBE.Api/ClientApp run build",
    "lint": "npm --prefix CourtManagementBE.Api/ClientApp run lint",
    "format": "npm --prefix CourtManagementBE.Api/ClientApp run format",
    "format:check": "npm --prefix CourtManagementBE.Api/ClientApp run format:check",
    "preview": "npm --prefix CourtManagementBE.Api/ClientApp run preview",
    "restore": "dotnet restore && npm --prefix CourtManagementBE.Api/ClientApp install",
    "install:client": "npm --prefix CourtManagementBE.Api/ClientApp install"
  }
}
